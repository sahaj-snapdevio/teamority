# Kanbanica environment variables
#
# Only the REQUIRED section below is needed to start Kanbanica.
#
# Everything under OPTIONAL can be left unset and configured later from:
#   • /setup (first-run wizard)
#   • Settings → Integrations
#
# Configuration saved in Kanbanica overrides values from this file.
# See docs/integrations.md for integration-specific documentation.

# ═══════════════════════════════════════════════════════════════════════════
# REQUIRED
# ═══════════════════════════════════════════════════════════════════════════

# PostgreSQL 16+ connection string.
# The default matches `pnpm db:local`.
# Managed databases (Neon, Supabase, RDS, etc.) and Docker examples are
# documented in DEPLOYMENT.md.
DATABASE_URL=postgresql://kanbanica:kanbanica@localhost:54329/kanbanica

# 32+ random characters used to sign sessions.
# Generate with: openssl rand -hex 32
APP_SECRET=replace-with-at-least-32-random-characters

# Public URL of your Kanbanica instance.
# Used for authentication links, invitation emails, and file URLs.
# Runtime-only. Restart the app after changing it.
# Deprecated alias (still supported): NEXT_PUBLIC_APP_URL
APP_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════════════════════
# OPTIONAL
# Everything below can be configured later inside Kanbanica.
# ═══════════════════════════════════════════════════════════════════════════

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Enables magic links, invitations, notifications, and email reminders.
# Compatible with any SMTP provider (Resend, Brevo, Postmark, SES, SMTP2GO,
# Mailgun, etc.). If left unset in local development, magic links are logged
# to the terminal instead.
#
# Production setup: DEPLOYMENT.md → "Production email (SMTP)"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@yourdomain.com

# Optional webhook secret for email delivery events.
# Supports either Authorization: Bearer <secret> or x-webhook-secret.
# EMAIL_WEBHOOK_SECRET=

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Enables "Continue with Google" authentication.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Password Sign-up ──────────────────────────────────────────────────────────
# Enables self-service account registration (/signup).
#
# Existing password accounts (including `pnpm create:admin`) can always sign
# in regardless of this setting.
#
# Configure at least ONE of the following so additional users can create
# accounts:
#   • SMTP
#   • Google OAuth
#   • Password sign-up
ALLOW_PASSWORD_SIGNUP=true

# ── File Storage ──────────────────────────────────────────────────────────────
# Storage driver:
#   local - stores uploads in ./uploads (default)
#   s3    - AWS S3-compatible storage
#   r2    - Cloudflare R2
#
# When using `local` in Docker, mount a persistent volume or uploaded files
# will be lost when the container is recreated.
STORAGE_DRIVER=local

# Required for S3/R2.
# Omit S3_ENDPOINT for AWS S3.
#
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=kanbanica
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── Web Push Notifications ───────────────────────────────────────────────────
# Browser and desktop notifications.
# Generate keys with:
#   npx web-push generate-vapid-keys
#
# If configured here, the app and worker must use the same keys.
VAPID_PUBLIC_KEY=your_public_key_here
VAPID_PRIVATE_KEY=your_private_key_here
VAPID_SUBJECT=mailto:your-email@example.com

# Deprecated fallback (runtime configuration preferred).
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_public_key_here

# ── Platform Admin Bootstrap ─────────────────────────────────────────────────
# Default: create the first administrator through the /setup wizard.
#
# When enabled, the first user who signs in is automatically promoted to
# platform administrator. This only occurs while the user table is empty.
#
# Recovery:
#   pnpm create:admin
AUTO_PROMOTE_FIRST_ADMIN=true

# ── Branding ─────────────────────────────────────────────────────────────────
# Optional overrides for branding shown in the UI.
# Defaults are defined in config/platform.ts.
#
# NEXT_PUBLIC_SUPPORT_EMAIL=support@yourcompany.com
# NEXT_PUBLIC_MARKETING_DOMAIN=yourcompany.com

# ── Marketing Landing Page ───────────────────────────────────────────────────
# Default: false
#
# false - Redirect "/" directly to login (recommended for self-hosted).
# true  - Serve the public marketing landing page (intended for hosted/demo
#         deployments).
NEXT_PUBLIC_SHOW_LANDING_PAGE=false

# ═══════════════════════════════════════════════════════════════════════════
# DOCKER COMPOSE ONLY
# ═══════════════════════════════════════════════════════════════════════════
# Used only by docker-compose.yml to provision the bundled PostgreSQL
# container. Ignored when using an external database or
# docker-compose.external-db.yml.
#
# These values must match DATABASE_URL (host: postgres, port: 5432).
#
# POSTGRES_USER=kanbanica
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=kanbanica
# APP_PORT=3000