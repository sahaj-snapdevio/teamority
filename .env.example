# ── Required ──────────────────────────────────────────────────────────────────
# DATABASE_URL — the only setting that chooses your database.
#   • Local dev (pnpm db:local):  postgresql://kanbanica:kanbanica@localhost:54329/kanbanica
#   • Docker Compose (bundled):   postgresql://kanbanica:<password>@postgres:5432/kanbanica
#     ("postgres" is the compose service name, not a hostname you must create.)
#
# Using your OWN PostgreSQL instead of the bundled container? Point this at it
# and start the stack with the external-db overlay:
#   docker compose -f docker-compose.yml -f docker-compose.external-db.yml up -d
#
# Any PostgreSQL 16+ reachable over the network works. Examples:
#   DATABASE_URL=postgresql://user:pass@db.internal:5432/kanbanica
#   DATABASE_URL=postgresql://user:pass@ep-xyz.neon.tech/kanbanica?sslmode=require
#   DATABASE_URL=postgresql://user:pass@rds.amazonaws.com:5432/kanbanica?sslmode=require
#
# Notes:
#   • Managed providers need TLS — append ?sslmode=require (or ?sslmode=verify-full
#     to also verify the certificate against the system CA store).
#   • Through a transaction pooler (pgbouncer), append ?pgbouncer=true so prepared
#     statements are disabled.
#   • If PostgreSQL runs on the Docker HOST, containers can't see "localhost" —
#     use host.docker.internal (see docker-compose.external-db.yml).
#   • POSTGRES_USER/PASSWORD/DB below are ignored unless you use the bundled DB.
DATABASE_URL=postgresql://kanbanica:kanbanica@localhost:54329/kanbanica
# APP_SECRET: 32+ random chars. Generate with:  openssl rand -hex 32
APP_SECRET=replace-with-at-least-32-random-characters
# APP_URL: the public URL users hit. In production use your real https domain,
# e.g. https://tasks.yourcompany.com — used for sign-in and invite links, email
# content, and file URLs. Read at RUNTIME, so changing it needs no rebuild.
# (The old name NEXT_PUBLIC_APP_URL still works, but is deprecated.)
APP_URL=http://localhost:3000

# ── Authentication providers ──────────────────────────────────────────────────
# In PRODUCTION you must configure AT LEAST ONE of: full SMTP (below), Google
# OAuth, or ALLOW_PASSWORD_SIGNUP=true. Otherwise nobody can obtain an account
# and the app refuses to start.
#
# Email (SMTP) — optional in local dev (magic links are logged to the console;
# no SMTP needed). Required in production to deliver magic-link emails.
#
# Kanbanica works with ANY SMTP provider — you supply the credentials:
#   Resend (recommended), Brevo, Postmark, Amazon SES, SMTP2GO, Mailgun, …
# Use port 587 (STARTTLS) unless your provider requires 465.
# EMAIL_FROM must be an address on a domain you've verified with the provider
# (set up SPF + DKIM, ideally DMARC) or mail will be rejected / land in spam.
# See DEPLOYMENT.md → "Production email (SMTP)" for per-provider setup.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Google OAuth — alternative login that works without SMTP.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email + password login. Signing IN with a password always works (that's how
# `pnpm create:admin` accounts reach /admin/login). This flag controls self-serve
# REGISTRATION — whether visitors can create their own account at /signup.
# EXPLICIT OPT-IN: leave "false" to keep the instance invite-only.
#
# When set to "true":
#   • /signup, and a password field on /login, become available.
#   • With SMTP configured, new sign-ups must verify their email before signing
#     in — and only a verified account can later link Google to the same login.
#   • Without SMTP, "Forgot password?" is hidden (the reset mail can't be sent).
#
# This also satisfies the production start-up check on its own: an instance with
# no SMTP and no Google is valid as long as password signup is enabled.
ALLOW_PASSWORD_SIGNUP=false

# ── Platform (Orbit) admin bootstrap ──────────────────────────────────────────
# By DEFAULT you don't need this: on a brand-new install the app sends you to the
# first-run setup wizard at /setup to create the admin account in the browser.
# Optional alternative — set to "true" so the FIRST user to sign in (magic link /
# Google / password) is auto-promoted to admin instead of using /setup. Only ever
# fires while the user table is empty.
# Recovery: provision an admin from the CLI with `pnpm create:admin`.
AUTO_PROMOTE_FIRST_ADMIN=false

# ── Docker Compose only (bundled Postgres) ────────────────────────────────────
# Used by docker-compose.yml to provision the bundled Postgres. Match these with
# the DATABASE_URL above (host = the "postgres" service, port 5432).
# IGNORED when you use docker-compose.external-db.yml — your DATABASE_URL is
# then the single source of truth for credentials.
# POSTGRES_USER=kanbanica
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=kanbanica
# APP_PORT=3000

# ── Email Webhook ──────────────────────────────────────────────────────────────
# Optional. Set this to receive delivery events from your SMTP provider.
# Accepts Authorization: Bearer <secret> or x-webhook-secret header.
# EMAIL_WEBHOOK_SECRET=

# ── File Storage (files-sdk) ──────────────────────────────────────────────────
# "local" stores files in ./uploads/ and serves via /api/files (default).
#   In Docker, mount a volume at /app/uploads (docker-compose.yml does this) or
#   uploads are lost on redeploy.
# "s3" or "r2" uses cloud object storage — set the S3_* credentials below.
STORAGE_DRIVER=local

# S3 / R2 credentials (only needed when STORAGE_DRIVER=s3 or r2)
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   # R2/MinIO only; omit for AWS S3
# S3_REGION=auto
# S3_BUCKET=kanbanica
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── Web Push (browser/desktop notifications) ──────────────────────────────────
# Optional. Generate with:  npx web-push generate-vapid-keys
# These are RUNTIME-only and work on any deployment (bare Node, PM2, Vercel,
# Railway/Render/Coolify, Docker) — the client fetches the public key at runtime
# from /api/push/vapid-public-key, so no build-time var and no rebuild on rotate.
# Set the same VAPID_* on the app AND the worker.
VAPID_PUBLIC_KEY=your_public_key_here
VAPID_PRIVATE_KEY=your_private_key_here
VAPID_SUBJECT=mailto:your-email@example.com
# Legacy/optional: only used as a build-time fallback if the runtime fetch fails.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_public_key_here

# ── Branding (optional) ───────────────────────────────────────────────────────
# Override the public support email / marketing domain shown in the UI without
# editing code. Defaults live in config/platform.ts.
# NEXT_PUBLIC_SUPPORT_EMAIL=support@yourcompany.com
# NEXT_PUBLIC_MARKETING_DOMAIN=yourcompany.com

# ── Marketing landing page (optional) ─────────────────────────────────────────
# The marketing landing page is meant for the hosted/demo instance. By default
# (unset) a self-hosted deployment redirects `/` straight to the login page.
# Set this to true to serve the landing page at `/` for logged-out visitors.
NEXT_PUBLIC_SHOW_LANDING_PAGE=false